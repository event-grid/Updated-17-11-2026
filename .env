# =====================================================================================================================
# EVENTGRID settings file. THIS COPY HAS PLACEHOLDERS ONLY.  >>> ADD YOUR OWN PASSWORDS before running the project. <<<
#
# Easiest: run  scripts\development\setup-demo.ps1  : it replaces every CHANGE_ME value below with a generated secret
# and prints the admin login. Or edit this file yourself and type your own values in place of each CHANGE_ME.
# Never put real passwords in a file you push to GitHub: after you add yours, do not commit this file.
# =====================================================================================================================

# --- Database (PostgreSQL). Choose any password: setup creates the database login with it. ---
POSTGRES_DB=evntgrid
POSTGRES_USER=evntgrid
POSTGRES_PASSWORD=CHANGE_ME_add_your_own_database_password
DATABASE_URL=jdbc:postgresql://localhost:5432/evntgrid

# --- Sign-in codes are shown on screen (development only). The dummy number 9999999999 always accepts 123456. ---
SESSION_COOKIE_NAME=evg_c
SESSION_COOKIE_SECURE=false
OTP_DEV_MODE=true
OTP_TEST_PHONE=9999999999
OTP_TEST_CODE=123456
API_DOCS_ENABLED=true
BOOKING_ADVANCE_PERCENT=20

# --- Admin portal: a long random secret (at least 24 characters) and the administrator's login. ---
ADMIN_API_TOKEN=CHANGE_ME_add_your_own_long_random_secret_of_24_or_more_characters
ADMIN_PORTAL_EMAIL=admin@evntgrid.local
ADMIN_PORTAL_PASSWORD=CHANGE_ME_add_your_own_admin_password
