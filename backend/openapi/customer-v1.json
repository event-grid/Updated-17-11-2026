{
  "components": {
    "schemas": {
      "ApiFieldError": {
        "description": "Present on VALIDATION_FAILED",
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ApiProblem": {
        "description": "Problem Details (RFC 9457) with a stable `code` and the request's `correlationId`.",
        "properties": {
          "code": {
            "description": "Stable error code, for example NOT_FOUND, VALIDATION_FAILED, REQUEST_MALFORMED",
            "example": "NOT_FOUND",
            "type": "string"
          },
          "correlationId": {
            "description": "Same value as the X-Correlation-Id response header",
            "type": "string"
          },
          "detail": {
            "example": "No event category exists with this identifier.",
            "type": "string"
          },
          "fieldErrors": {
            "description": "Present on VALIDATION_FAILED",
            "items": {
              "$ref": "#/components/schemas/ApiFieldError"
            },
            "type": "array"
          },
          "instance": {
            "type": "string"
          },
          "status": {
            "example": 404,
            "format": "int32",
            "type": "integer"
          },
          "title": {
            "example": "Not found",
            "type": "string"
          },
          "type": {
            "example": "about:blank",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Booking": {
        "properties": {
          "advancePaidAt": {
            "format": "date-time",
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "firstEventDate": {
            "format": "date",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/BookingItem"
            },
            "type": "array"
          },
          "reference": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "totals": {
            "$ref": "#/components/schemas/Totals"
          }
        },
        "required": [
          "createdAt",
          "firstEventDate",
          "items",
          "reference",
          "status",
          "totals"
        ],
        "type": "object"
      },
      "BookingItem": {
        "properties": {
          "categoryName": {
            "type": "string"
          },
          "eventDate": {
            "format": "date",
            "type": "string"
          },
          "lineTotalMinor": {
            "format": "int64",
            "type": "integer"
          },
          "listingTitle": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "packageTitle": {
            "type": "string"
          },
          "priceUnit": {
            "type": "string"
          },
          "providerName": {
            "type": "string"
          },
          "quantity": {
            "format": "int32",
            "type": "integer"
          },
          "unitPriceMinor": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "categoryName",
          "eventDate",
          "lineTotalMinor",
          "listingTitle",
          "packageTitle",
          "priceUnit",
          "providerName",
          "quantity",
          "unitPriceMinor"
        ],
        "type": "object"
      },
      "BookingSummary": {
        "properties": {
          "advanceMinor": {
            "format": "int64",
            "type": "integer"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "firstEventDate": {
            "format": "date",
            "type": "string"
          },
          "itemCount": {
            "format": "int32",
            "type": "integer"
          },
          "reference": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "title": {
            "description": "First item, for display",
            "type": "string"
          },
          "totalMinor": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "advanceMinor",
          "createdAt",
          "firstEventDate",
          "itemCount",
          "reference",
          "status",
          "title",
          "totalMinor"
        ],
        "type": "object"
      },
      "Cart": {
        "properties": {
          "checkoutReady": {
            "type": "boolean"
          },
          "itemCount": {
            "format": "int32",
            "type": "integer"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/CartLine"
            },
            "type": "array"
          },
          "paymentsEnabled": {
            "description": "False until Razorpay keys are configured",
            "type": "boolean"
          },
          "totals": {
            "$ref": "#/components/schemas/Totals"
          }
        },
        "required": [
          "checkoutReady",
          "itemCount",
          "items",
          "paymentsEnabled",
          "totals"
        ],
        "type": "object"
      },
      "CartItemRequest": {
        "properties": {
          "eventDate": {
            "format": "date",
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "packageId": {
            "format": "uuid",
            "type": "string"
          },
          "quantity": {
            "description": "Units, or guests for PER_GUEST packages",
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "eventDate",
          "packageId",
          "quantity"
        ],
        "type": "object"
      },
      "CartItemUpdate": {
        "properties": {
          "eventDate": {
            "format": "date",
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "quantity": {
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "eventDate",
          "quantity"
        ],
        "type": "object"
      },
      "CartLine": {
        "properties": {
          "available": {
            "description": "False when the package is no longer offered; remove it to check out",
            "type": "boolean"
          },
          "categoryName": {
            "type": "string"
          },
          "eventDate": {
            "format": "date",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "lineTotalMinor": {
            "format": "int64",
            "type": "integer"
          },
          "listingSlug": {
            "type": "string"
          },
          "listingTitle": {
            "type": "string"
          },
          "maxQuantity": {
            "format": "int32",
            "type": "integer"
          },
          "minQuantity": {
            "format": "int32",
            "type": "integer"
          },
          "notes": {
            "type": "string"
          },
          "packageId": {
            "type": "string"
          },
          "packageTitle": {
            "type": "string"
          },
          "priceUnit": {
            "description": "FIXED or PER_GUEST",
            "type": "string"
          },
          "problem": {
            "description": "Why this line blocks checkout, if it does",
            "type": "string"
          },
          "providerName": {
            "type": "string"
          },
          "providerSlug": {
            "type": "string"
          },
          "quantity": {
            "format": "int32",
            "type": "integer"
          },
          "unitPriceMinor": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "available",
          "categoryName",
          "eventDate",
          "id",
          "lineTotalMinor",
          "listingSlug",
          "listingTitle",
          "maxQuantity",
          "minQuantity",
          "packageId",
          "packageTitle",
          "priceUnit",
          "providerName",
          "quantity",
          "unitPriceMinor"
        ],
        "type": "object"
      },
      "CheckoutSession": {
        "properties": {
          "amountMinor": {
            "format": "int64",
            "type": "integer"
          },
          "bookingReference": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "razorpayKeyId": {
            "description": "Public key ID for Razorpay Checkout",
            "type": "string"
          },
          "razorpayOrderId": {
            "type": "string"
          }
        },
        "required": [
          "amountMinor",
          "bookingReference",
          "currency",
          "razorpayKeyId",
          "razorpayOrderId"
        ],
        "type": "object"
      },
      "EmailCode": {
        "properties": {
          "challengeId": {
            "format": "uuid",
            "type": "string"
          },
          "devCode": {
            "description": "Development mode only: the code itself, to show on screen",
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "resendAfterSeconds": {
            "format": "int32",
            "type": "integer"
          },
          "sentTo": {
            "description": "Masked address for display",
            "type": "string"
          }
        },
        "required": [
          "challengeId",
          "expiresAt",
          "resendAfterSeconds",
          "sentTo"
        ],
        "type": "object"
      },
      "EmailCodeRequest": {
        "properties": {
          "email": {
            "description": "The email address to add or change to",
            "example": "priya@example.com",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "EmailVerification": {
        "properties": {
          "challengeId": {
            "format": "uuid",
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "challengeId",
          "code"
        ],
        "type": "object"
      },
      "FavouriteItem": {
        "properties": {
          "city": {
            "type": "string"
          },
          "demo": {
            "type": "boolean"
          },
          "fromPriceMinor": {
            "format": "int64",
            "type": "integer"
          },
          "priceUnit": {
            "type": "string"
          },
          "providerSlug": {
            "description": "Provider page that shows this item",
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "enum": [
              "VENUE",
              "LISTING"
            ],
            "type": "string"
          }
        },
        "required": [
          "city",
          "demo",
          "slug",
          "subtitle",
          "title",
          "type"
        ],
        "type": "object"
      },
      "Notification": {
        "properties": {
          "actionPath": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "read": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "description": "BOOKING_ADVANCE_PAID or BOOKING_PAYMENT_FAILED",
            "type": "string"
          }
        },
        "required": [
          "body",
          "createdAt",
          "id",
          "read",
          "title",
          "type"
        ],
        "type": "object"
      },
      "NotificationList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Notification"
            },
            "type": "array"
          },
          "unreadCount": {
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "unreadCount"
        ],
        "type": "object"
      },
      "PaymentVerification": {
        "properties": {
          "razorpayOrderId": {
            "type": "string"
          },
          "razorpayPaymentId": {
            "type": "string"
          },
          "razorpaySignature": {
            "type": "string"
          }
        },
        "required": [
          "razorpayOrderId",
          "razorpayPaymentId",
          "razorpaySignature"
        ],
        "type": "object"
      },
      "ProfileUpdate": {
        "properties": {
          "displayName": {
            "description": "Up to 80 characters; empty clears it",
            "type": "string"
          }
        },
        "type": "object"
      },
      "SignedInAccount": {
        "properties": {
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "description": "E.164, for example +919876543210",
            "type": "string"
          },
          "userId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "userId"
        ],
        "type": "object"
      },
      "Totals": {
        "properties": {
          "advanceMinor": {
            "description": "Paid online at checkout",
            "format": "int64",
            "type": "integer"
          },
          "advancePercent": {
            "format": "int32",
            "type": "integer"
          },
          "balanceMinor": {
            "description": "Paid to the provider later",
            "format": "int64",
            "type": "integer"
          },
          "totalMinor": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "advanceMinor",
          "advancePercent",
          "balanceMinor",
          "totalMinor"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Errors use Problem Details (RFC 9457) with `code` and `correlationId`. Every response carries `X-Correlation-Id`.",
    "title": "EVNTGRID API",
    "version": "v1"
  },
  "openapi": "3.0.1",
  "paths": {
    "/api/customer/v1/bookings": {
      "get": {
        "operationId": "listBookings",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BookingSummary"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Bookings, newest first",
        "tags": [
          "shopping"
        ]
      }
    },
    "/api/customer/v1/bookings/{reference}": {
      "get": {
        "operationId": "getBooking",
        "parameters": [
          {
            "in": "path",
            "name": "reference",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "One booking",
        "tags": [
          "shopping"
        ]
      }
    },
    "/api/customer/v1/bookings/{reference}/payment-order": {
      "post": {
        "operationId": "retryBookingPayment",
        "parameters": [
          {
            "in": "path",
            "name": "reference",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutSession"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "A new Razorpay order for a booking still awaiting its advance",
        "tags": [
          "shopping"
        ]
      }
    },
    "/api/customer/v1/bookings/{reference}/payment-verification": {
      "post": {
        "operationId": "verifyBookingPayment",
        "parameters": [
          {
            "in": "path",
            "name": "reference",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentVerification"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            },
            "description": "Verified; the booking with its new status"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Signature or order does not match (PAYMENT_NOT_VERIFIED)"
          }
        },
        "summary": "Verify the Razorpay Checkout result; the booking is updated only if it verifies",
        "tags": [
          "shopping"
        ]
      }
    },
    "/api/customer/v1/cart": {
      "get": {
        "operationId": "getCart",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cart"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "The cart with live prices and the advance due at checkout",
        "tags": [
          "shopping"
        ]
      }
    },
    "/api/customer/v1/cart/items": {
      "post": {
        "operationId": "addCartItem",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CartItemRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cart"
                }
              }
            },
            "description": "The updated cart"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Invalid quantity, date or notes (VALIDATION_FAILED), or cart full (CART_FULL)"
          }
        },
        "summary": "Add a package for an event date (same package and date: replaces the quantity)",
        "tags": [
          "shopping"
        ]
      }
    },
    "/api/customer/v1/cart/items/{itemId}": {
      "delete": {
        "operationId": "removeCartItem",
        "parameters": [
          {
            "in": "path",
            "name": "itemId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cart"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Remove a cart item",
        "tags": [
          "shopping"
        ]
      },
      "patch": {
        "operationId": "updateCartItem",
        "parameters": [
          {
            "in": "path",
            "name": "itemId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CartItemUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cart"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Change quantity, date or notes of a cart item",
        "tags": [
          "shopping"
        ]
      }
    },
    "/api/customer/v1/checkout": {
      "post": {
        "description": "The cart is emptied. Open Razorpay Checkout with the returned order, then call payment-verification.",
        "operationId": "checkout",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutSession"
                }
              }
            },
            "description": "Booking created, awaiting payment"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Cart empty or needs attention (CART_EMPTY, CART_INVALID)"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Razorpay keys not configured (PAYMENTS_NOT_CONFIGURED)"
          }
        },
        "summary": "Turn the cart into a booking and open a Razorpay order for the advance",
        "tags": [
          "shopping"
        ]
      }
    },
    "/api/customer/v1/favourites": {
      "get": {
        "operationId": "listFavourites",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/FavouriteItem"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Saved venues and services, newest first",
        "tags": [
          "favourites"
        ]
      }
    },
    "/api/customer/v1/favourites/{type}/{slug}": {
      "delete": {
        "operationId": "removeFavourite",
        "parameters": [
          {
            "in": "path",
            "name": "type",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "summary": "Remove a saved venue or service (type: venue or listing)",
        "tags": [
          "favourites"
        ]
      },
      "put": {
        "operationId": "addFavourite",
        "parameters": [
          {
            "in": "path",
            "name": "type",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "summary": "Save a venue or service (type: venue or listing)",
        "tags": [
          "favourites"
        ]
      }
    },
    "/api/customer/v1/me": {
      "get": {
        "operationId": "getMe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedInAccount"
                }
              }
            },
            "description": "Signed in"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Not signed in (AUTH_REQUIRED)"
          }
        },
        "summary": "The signed-in customer",
        "tags": [
          "session"
        ]
      },
      "patch": {
        "operationId": "updateMe",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedInAccount"
                }
              }
            },
            "description": "Updated"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Name too long (VALIDATION_FAILED)"
          }
        },
        "summary": "Change the display name",
        "tags": [
          "session"
        ]
      }
    },
    "/api/customer/v1/me/email": {
      "post": {
        "operationId": "verifyEmail",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailVerification"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedInAccount"
                }
              }
            },
            "description": "Email saved"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Used by another account (EMAIL_IN_USE)"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Wrong or expired code (OTP_INVALID, OTP_EXPIRED)"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Too many wrong codes (OTP_ATTEMPTS_EXCEEDED)"
          }
        },
        "summary": "Confirm the code and save the verified email address",
        "tags": [
          "session"
        ]
      }
    },
    "/api/customer/v1/me/email/codes": {
      "post": {
        "description": "The address is saved only after the code is confirmed with POST /me/email.",
        "operationId": "requestEmailCode",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailCodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailCode"
                }
              }
            },
            "description": "Code sent (in development mode `devCode` holds it)"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Used by another account (EMAIL_IN_USE)"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Invalid address (VALIDATION_FAILED)"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Too many codes (OTP_RATE_LIMITED, OTP_RESEND_TOO_SOON)"
          }
        },
        "summary": "Send a code to an email address to add or change the customer's email",
        "tags": [
          "session"
        ]
      }
    },
