{
  "components": {
    "schemas": {
      "AdminBooking": {
        "properties": {
          "advanceMinor": {
            "format": "int64",
            "type": "integer"
          },
          "advancePaidAt": {
            "format": "date-time",
            "type": "string"
          },
          "balanceMinor": {
            "format": "int64",
            "type": "integer"
          },
          "commissionMinor": {
            "description": "Kept by the platform across all items; providers receive the rest",
            "format": "int64",
            "type": "integer"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "customerId": {
            "format": "uuid",
            "type": "string"
          },
          "firstEventDate": {
            "format": "date",
            "type": "string"
          },
          "itemCount": {
            "format": "int32",
            "type": "integer"
          },
          "reference": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "title": {
            "description": "First item, for display",
            "type": "string"
          },
          "totalMinor": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "advanceMinor",
          "balanceMinor",
          "commissionMinor",
          "createdAt",
          "customerId",
          "itemCount",
          "reference",
          "status",
          "title",
          "totalMinor"
        ],
        "type": "object"
      },
      "AdminBookingDetail": {
        "properties": {
          "booking": {
            "$ref": "#/components/schemas/AdminBooking"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/AdminBookingItem"
            },
            "type": "array"
          }
        },
        "required": [
          "booking",
          "items"
        ],
        "type": "object"
      },
      "AdminBookingItem": {
        "properties": {
          "categoryName": {
            "type": "string"
          },
          "commissionBps": {
            "description": "The commission rate in force when this was booked, in basis points (500 = 5%)",
            "format": "int32",
            "type": "integer"
          },
          "commissionMinor": {
            "description": "Kept by the platform",
            "format": "int64",
            "type": "integer"
          },
          "eventDate": {
            "format": "date",
            "type": "string"
          },
          "lineTotalMinor": {
            "format": "int64",
            "type": "integer"
          },
          "listingTitle": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "packageTitle": {
            "type": "string"
          },
          "priceUnit": {
            "type": "string"
          },
          "providerName": {
            "type": "string"
          },
          "providerPayoutMinor": {
            "description": "What the provider receives: the line total minus the commission",
            "format": "int64",
            "type": "integer"
          },
          "quantity": {
            "format": "int32",
            "type": "integer"
          },
          "unitPriceMinor": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "categoryName",
          "commissionBps",
          "commissionMinor",
          "eventDate",
          "lineTotalMinor",
          "listingTitle",
          "packageTitle",
          "priceUnit",
          "providerName",
          "providerPayoutMinor",
          "quantity",
          "unitPriceMinor"
        ],
        "type": "object"
      },
      "AdminBookingPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AdminBooking"
            },
            "type": "array"
          },
          "page": {
            "format": "int32",
            "type": "integer"
          },
          "size": {
            "format": "int32",
            "type": "integer"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "page",
          "size",
          "total"
        ],
        "type": "object"
      },
      "AdminBookingStats": {
        "properties": {
          "advanceCollectedMinor": {
            "description": "Sum of advances on bookings whose advance is paid",
            "format": "int64",
            "type": "integer"
          },
          "advancePaid": {
            "format": "int64",
            "type": "integer"
          },
          "commissionEarnedMinor": {
            "description": "Commission on bookings whose advance is paid, that is on successful bookings",
            "format": "int64",
            "type": "integer"
          },
          "expired": {
            "format": "int64",
            "type": "integer"
          },
          "paymentFailed": {
            "format": "int64",
            "type": "integer"
          },
          "pendingPayment": {
            "format": "int64",
            "type": "integer"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "advanceCollectedMinor",
          "advancePaid",
          "commissionEarnedMinor",
          "expired",
          "paymentFailed",
          "pendingPayment",
          "total"
        ],
        "type": "object"
      },
      "AdminCommission": {
        "properties": {
          "history": {
            "description": "Latest changes first (up to 20)",
            "items": {
              "$ref": "#/components/schemas/CommissionChange"
            },
            "type": "array"
          },
          "rate": {
            "$ref": "#/components/schemas/CommissionRate"
          }
        },
        "required": [
          "history",
          "rate"
        ],
        "type": "object"
      },
      "AdminCustomer": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "lastSignInAt": {
            "format": "date-time",
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "createdAt",
          "id",
          "status"
        ],
        "type": "object"
      },
      "AdminCustomerPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AdminCustomer"
            },
            "type": "array"
          },
          "page": {
            "format": "int32",
            "type": "integer"
          },
          "size": {
            "format": "int32",
            "type": "integer"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "page",
          "size",
          "total"
        ],
        "type": "object"
      },
      "AdminCustomerStatusChange": {
        "properties": {
          "status": {
            "description": "ACTIVE or SUSPENDED",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "AdminCustomerSummary": {
        "properties": {
          "active": {
            "format": "int64",
            "type": "integer"
          },
          "newLast7Days": {
            "format": "int64",
            "type": "integer"
          },
          "suspended": {
            "format": "int64",
            "type": "integer"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "active",
          "newLast7Days",
          "suspended",
          "total"
        ],
        "type": "object"
      },
      "ApiFieldError": {
        "description": "Present on VALIDATION_FAILED",
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ApiProblem": {
        "description": "Problem Details (RFC 9457) with a stable `code` and the request's `correlationId`.",
        "properties": {
          "code": {
            "description": "Stable error code, for example NOT_FOUND, VALIDATION_FAILED, REQUEST_MALFORMED",
            "example": "NOT_FOUND",
            "type": "string"
          },
          "correlationId": {
            "description": "Same value as the X-Correlation-Id response header",
            "type": "string"
          },
          "detail": {
            "example": "No event category exists with this identifier.",
            "type": "string"
          },
          "fieldErrors": {
            "description": "Present on VALIDATION_FAILED",
            "items": {
              "$ref": "#/components/schemas/ApiFieldError"
            },
            "type": "array"
          },
          "instance": {
            "type": "string"
          },
          "status": {
            "example": 404,
            "format": "int32",
            "type": "integer"
          },
          "title": {
            "example": "Not found",
            "type": "string"
          },
          "type": {
            "example": "about:blank",
            "type": "string"
          }
        },
        "type": "object"
      },
      "CommissionChange": {
        "description": "Latest changes first (up to 20)",
        "properties": {
          "changedAt": {
            "format": "date-time",
            "type": "string"
          },
          "newPercent": {
            "type": "number"
          },
          "oldPercent": {
            "type": "number"
          }
        },
        "required": [
          "changedAt",
          "newPercent",
          "oldPercent"
        ],
        "type": "object"
      },
      "CommissionRate": {
        "properties": {
          "rateBps": {
            "description": "Basis points: 500 means 5%",
            "format": "int32",
            "type": "integer"
          },
          "ratePercent": {
            "description": "The same rate as a percentage, for example 5.00",
            "type": "number"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "rateBps",
          "ratePercent",
          "updatedAt"
        ],
        "type": "object"
      },
      "CommissionRateChange": {
        "properties": {
          "ratePercent": {
            "description": "0 to 30, at most 2 decimals",
            "example": 5,
            "type": "number"
          }
        },
        "required": [
          "ratePercent"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Errors use Problem Details (RFC 9457) with `code` and `correlationId`. Every response carries `X-Correlation-Id`.",
    "title": "EVNTGRID API",
    "version": "v1"
  },
  "openapi": "3.0.1",
  "paths": {
    "/api/admin/v1/bookings": {
      "get": {
        "operationId": "listBookings",
        "parameters": [
          {
            "description": "PENDING_PAYMENT, ADVANCE_PAID, PAYMENT_FAILED or EXPIRED; omit for all",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "description": "PENDING_PAYMENT, ADVANCE_PAID, PAYMENT_FAILED or EXPIRED; omit for all",
              "type": "string"
            }
          },
          {
            "description": "Part of the booking reference",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "description": "Part of the booking reference",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "format": "int32",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminBookingPage"
                }
              }
            },
            "description": "One page of bookings (may be empty)"
          }
        },
        "summary": "Every customer's bookings, newest first, filterable and paged",
        "tags": [
          "admin-bookings"
        ]
      }
    },
    "/api/admin/v1/bookings/stats": {
      "get": {
        "operationId": "getBookingStats",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminBookingStats"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Counts and money collected, for the dashboard",
        "tags": [
          "admin-bookings"
        ]
      }
    },
    "/api/admin/v1/bookings/{reference}": {
      "get": {
        "operationId": "getBooking",
        "parameters": [
          {
            "in": "path",
            "name": "reference",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminBookingDetail"
                }
              }
            },
            "description": "The booking"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "No such booking (NOT_FOUND)"
          }
        },
        "summary": "One booking with its items",
        "tags": [
          "admin-bookings"
        ]
      }
    },
    "/api/admin/v1/commission": {
      "get": {
        "operationId": "getCommission",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminCommission"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "The current rate and its history",
        "tags": [
          "admin-commission"
        ]
      },
      "put": {
        "description": "Applies to bookings made from now on; existing bookings keep the rate they were made with.",
        "operationId": "setCommission",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommissionRateChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommissionRate"
                }
              }
            },
            "description": "The new rate"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Not between 0 and 30 (VALIDATION_FAILED)"
          }
        },
        "summary": "Raise or lower the commission",
        "tags": [
          "admin-commission"
        ]
      }
    },
    "/api/admin/v1/customers": {
      "get": {
        "operationId": "listCustomers",
        "parameters": [
          {
            "description": "Matches name, email or mobile number",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "description": "Matches name, email or mobile number",
              "type": "string"
            }
          },
          {
            "description": "ACTIVE or SUSPENDED; omit for all",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "description": "ACTIVE or SUSPENDED; omit for all",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "format": "int32",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminCustomerPage"
                }
              }
            },
            "description": "One page of customers (may be empty)"
          }
        },
        "summary": "Customer accounts, newest first, searchable and paged",
        "tags": [
          "admin-customers"
        ]
      }
    },
    "/api/admin/v1/customers/summary": {
      "get": {
        "operationId": "getCustomerSummary",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminCustomerSummary"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Counts for the dashboard",
        "tags": [
          "admin-customers"
        ]
      }
    },
    "/api/admin/v1/customers/{id}": {
      "patch": {
        "operationId": "setCustomerStatus",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminCustomerStatusChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminCustomer"
                }
              }
            },
            "description": "Updated"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "No such customer (NOT_FOUND)"
          }
        },
        "summary": "Suspend or reactivate a customer",
        "tags": [
          "admin-customers"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Clients set their own base URL",
      "url": "/"
    }
  ],
  "tags": [
    {
      "description": "Commission rate",
      "name": "admin-commission"
    },
    {
      "description": "All bookings",
      "name": "admin-bookings"
    },
    {
      "description": "Customer accounts",
      "name": "admin-customers"
    }
  ]
}
