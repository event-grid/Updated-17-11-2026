    "/api/public/v1/venues": {
      "get": {
        "operationId": "searchVenues",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "city",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Venue type code",
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Expected guests; venues too small are left out",
            "in": "query",
            "name": "guests",
            "required": false,
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "description": "Highest starting price in rupees",
            "in": "query",
            "name": "maxPrice",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "Event category slug",
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "relevance, price_asc, price_desc or capacity",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "format": "int32",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VenuePage"
                }
              }
            },
            "description": "One page of venues (may be empty)"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Invalid filter (VALIDATION_FAILED)"
          }
        },
        "summary": "Venues, filtered and paged (12 per page)",
        "tags": [
          "marketplace"
        ]
      }
    },
    "/api/public/v1/venues/{slug}": {
      "get": {
        "operationId": "getVenue",
        "parameters": [
          {
