# Local development only. Copy to .env and fill in. Never commit .env.
# Placeholders only: no real value belongs in this file.
# The frontends need no secrets. They call the backend through same-origin routing.
# Names below follow SYSTEM_ARCHITECTURE.md and DEPLOYMENT_ARCHITECTURE.md.
# Resource names are NOT decided. Replace change_me with real names later.

# --- PostgreSQL (backend only) ---
POSTGRES_DB=evntgrid
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
DATABASE_URL=jdbc:postgresql://localhost:5432/evntgrid

# --- Redis (backend only) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- AWS region (AWS Mumbai is the recommended region, AR-10) ---
AWS_REGION=ap-south-1

# --- S3: three buckets (SYSTEM_ARCHITECTURE.md section 5) ---
S3_PUBLIC_MEDIA_BUCKET=change_me
S3_PRIVATE_DOCUMENTS_BUCKET=change_me
S3_QUARANTINE_UPLOADS_BUCKET=change_me

# --- SQS: every queue has a dead-letter queue (DLQ) ---
# The queue list is illustrative (DEPLOYMENT_ARCHITECTURE.md section 5) and not final.
SQS_NOTIFICATIONS_QUEUE=change_me
SQS_NOTIFICATIONS_DLQ=change_me
SQS_MEDIA_PROCESSING_QUEUE=change_me
SQS_MEDIA_PROCESSING_DLQ=change_me
# Only if slower webhook processing is needed:
SQS_PAYMENT_EVENTS_QUEUE=change_me
SQS_PAYMENT_EVENTS_DLQ=change_me

# --- Razorpay (cart checkout: an advance is paid online; owner decision 2026-11-13) ---
# Development: use TEST-mode keys from the Razorpay dashboard (Settings > API Keys, they start with rzp_test_).
# Checkout stays switched off ("Online payment is not available yet") while these are empty or change_me.
# The key ID is public by design: the backend sends it to the browser for Razorpay Checkout.
RAZORPAY_KEY_ID=change_me
# The key secret and the webhook secret stay on the server. Never expose them to a frontend.
RAZORPAY_KEY_SECRET=change_me
# Webhook URL to set in the dashboard: https://<site>/api/webhooks/razorpay
# Events: payment.captured, payment.failed, order.paid. Local testing needs a tunnel (for example ngrok).
RAZORPAY_WEBHOOK_SECRET=change_me

# Share of the cart total paid online at checkout (1 to 100). The rest is paid to the providers.
BOOKING_ADVANCE_PERCENT=20

# Demo venues, providers and packages (db/demo, all marked "Demo"). Production sets this to empty to leave them out:
# DEMO_DATA_MIGRATIONS=
# --- Customer session cookie ---
# Production: leave both unset (cookie __Host-evg_c, Secure). Local http development needs these two:
SESSION_COOKIE_NAME=evg_c
SESSION_COOKIE_SECURE=false

# --- Sign-in codes (OTP) by mobile number or email ---
# Development mode shows the code on screen, so no SMS or email is needed. NEVER true in production.
OTP_DEV_MODE=true
# Dummy mobile number for testing: always accepts OTP_TEST_CODE, no SMS sent. Only works in development mode.
OTP_TEST_PHONE=9999999999
OTP_TEST_CODE=123456

# --- Email (SMTP) for sign-in codes ---
# Leave SMTP_HOST empty to send no email. Port 587 uses STARTTLS, port 465 uses TLS.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_USERNAME=<address>, SMTP_PASSWORD=<16-character app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=change_me
SMTP_PASSWORD=change_me
SMTP_FROM=EVENTGRID <no-reply@example.com>
SMTP_STARTTLS=true

# --- SMS gateway for mobile sign-in codes ---
# Provider not decided yet (for example MSG91 or Twilio); these are placeholders and are not used yet.
# Until then, mobile sign-in works only with OTP_DEV_MODE=true.
SMS_PROVIDER=
SMS_API_KEY=change_me
SMS_SENDER_ID=change_me

# --- API documentation (Swagger UI) ---
# Set to false in production.
API_DOCS_ENABLED=true
